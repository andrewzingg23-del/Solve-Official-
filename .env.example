# Supabase → Project Settings → API Keys.
# The legacy anon key also works in place of the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Money is built and tested but off the default path (master spec §2). Unset means off.
# Payments need ENABLE_MONEY; external financial actions need ENABLE_PAYMENTS.
# ENABLE_MONEY=false
# ENABLE_PAYMENTS=false
# ENABLE_EXTERNAL_FINANCIAL_ACTIONS=false
