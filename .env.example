# Supabase → Project Settings → API Keys.
# The legacy anon key also works in place of the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Money is built and tested but off the default path (master spec §2). Unset means off.
# Payments need ENABLE_MONEY; external financial actions need ENABLE_PAYMENTS.
# ENABLE_MONEY=false
# ENABLE_PAYMENTS=false
# ENABLE_EXTERNAL_FINANCIAL_ACTIONS=false

# Anchoring the record on Solana (crypto stage 1). Devnet only until the founder decides on mainnet.
# Only a fingerprint of a World's history is written on chain. The payer key only pays network fees:
# use a dedicated devnet keypair (a JSON array of 64 numbers), never a wallet that holds anything.
# ANCHOR_CLUSTER=solana-devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# ANCHOR_PAYER_KEY=[...]

# The repo as a source for a Build Room (read-only). A fine-grained GitHub token with read-only
# Actions, Contents, Metadata and Pull requests on the repository. It is used only where a pairing
# names the repository: in solve.rooms.json (committed; readers by email fingerprint or World id), or
# here in GITHUB_ROOMS: "<World id or sign-in email>=<owner>/<repo>@<trunk>", separated by commas.
# Without a token, a room on the deployed repository still shows the deployed trunk's history.
# GITHUB_TOKEN=github_pat_...
# GITHUB_ROOMS=you@example.com=owner/repo@main
